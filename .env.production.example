# ============================================================
# DevTrace - Variables de Entorno para Producción (Ubuntu Server)
# Copiar este archivo como: .env
# ============================================================

# 1. Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Sistemas123456_CambiarEnProduccion!
POSTGRES_DB=trazabilidad_db

# 2. Seguridad JWT (Generar cadenas largas y aleatorias para producción)
# Puedes generar una clave segura con: openssl rand -base64 48
JWT_ACCESS_SECRET=clave_secreta_acceso_muy_segura_y_aleatoria_generada_para_produccion
JWT_REFRESH_SECRET=clave_secreta_refresh_muy_segura_y_aleatoria_generada_para_produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 3. Puertos de Exposición del Servidor
HTTP_PORT=80
# Si vas a usar Adminer (opcional):
ADMINER_PORT=8080

# 4. Parámetros de Archivos Adjuntos
MAX_FILE_SIZE_MB=30
