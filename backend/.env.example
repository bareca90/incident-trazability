# ============================================================
# Backend — Variables de entorno
# Copiar como .env y completar valores reales
# ============================================================

NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL (Docker)
DATABASE_URL="postgresql://postgres:Sistemas123456@localhost:5432/trazabilidad_db"

# JWT
JWT_ACCESS_SECRET=cambia_este_secreto_acceso_muy_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_diferente_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
